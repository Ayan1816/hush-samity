+function analyzeWithRegex(input) {
+  const withoutComments = input
+    .replace(/\/\*[\s\S]*?\*\//g, "")
+    .replace(/\/\/.*$/gm, "");
+  const imports = [];
+  const importRe = /import\s+(?:[^'"]*?\s+from\s+)?['"]([^'"]+)['"]/g;
+  let match;
+  while ((match = importRe.exec(withoutComments))) {
+    imports.push(match[1]);
+  }
+  const versionPragmas = [];
+  const pragmaRe = /pragma\s+solidity\s+([^;]+);/g;
+  while ((match = pragmaRe.exec(withoutComments))) {
+    versionPragmas.push(match[1].trim());
+  }
+  return { versionPragmas, imports };
+}
