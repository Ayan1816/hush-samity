{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": ["./hardhat.config.ts", "./tasks/**/*", "./test/**/*", "./scripts/**/*"],
  "exclude": ["frontend", "node_modules", "artifacts", "cache"]
}
