# Testnet signer. Never commit a real key. 0x-prefixed 32-byte hex.
PRIVATE_KEY=

# Optional RPC overrides. The Hardhat plugin injects public RPCs for
# eth-sepolia and arb-sepolia. base-sepolia is set in hardhat.config.ts.
SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=
BASESCAN_API_KEY=
